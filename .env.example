# ==============================================================================
# Autonomous Stock Trading Agent — Environment Configuration Template
# Copy to `.env` and fill in your credentials. Never commit `.env`.
# ==============================================================================

# --- Trading Mode & Safety Locks ----------------------------------------------
# Mode must agree with ALPACA_BASE_URL (fail-closed at startup).
# Switching to LIVE requires BOTH `STOCK_AGENT_MODE=LIVE`,
# `ALPACA_BASE_URL=https://api.alpaca.markets`, AND
# `STOCK_AGENT_LIVE_CONFIRMED=true`.
STOCK_AGENT_MODE=PAPER
ALPACA_BASE_URL=https://paper-api.alpaca.markets
STOCK_AGENT_LIVE_CONFIRMED=false

# Emergency entry pause: blocks new buys/option openings while exits, stop
# repairs, reconciliation, and alerts continue. Creating `data/PAUSED` has the
# same effect without restarting the service.
STOCK_TRADING_PAUSED=false

# --- Alpaca Broker & Market Data (Required) -----------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex

# --- News, Fundamentals & Filings ---------------------------------------------
FINNHUB_API_KEY=
FMP_API_KEY=
FMP_QUOTES_ENABLED=true
# Optional SEC EDGAR User-Agent (e.g. "AppName contact@example.com")
SEC_USER_AGENT=

# --- Optional TipRanks Enrichment ---------------------------------------------
TIPRANKS_API_KEY=
TIPRANKS_API_TOKEN=
TIPRANKS_EMAIL=
TIPRANKS_PASSWORD=

# --- Research & LLM Providers (at least one API key recommended) --------------
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
RESEARCH_PROVIDER_ORDER=openai,perplexity,anthropic
RESEARCH_WEEKLY_BUDGET_USD=15.0

# --- Options Policy (`off` | `defined_risk` | `legacy`) -----------------------
OPTIONS_MODE=defined_risk

# --- Alerts, Heartbeat & Logging ----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEARTBEAT_PING_URL=
STOCK_LOG_LEVEL=INFO
