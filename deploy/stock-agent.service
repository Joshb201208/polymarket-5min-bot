[Unit]
Description=Stock Trading Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/polymarket-bot
EnvironmentFile=/root/polymarket-bot/.env
ExecStartPre=/usr/bin/git -C /root/polymarket-bot fetch --all
ExecStartPre=/usr/bin/git -C /root/polymarket-bot reset --hard origin/master
ExecStart=/root/polymarket-bot/venv/bin/python -m stock_agent
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
