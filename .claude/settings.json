{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git grep *)",
      "Bash(git branch --show-current)",
      "Bash(python3 -m pytest *)",
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(python3 -m compileall *)",
      "Bash(python -m compileall *)",
      "Bash(ruff check *)",
      "Bash(python3 -m ruff check *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * master)",
      "Bash(git push * main)",
      "Bash(gh pr merge *)",
      "Bash(python -m stock_agent)",
      "Bash(python3 -m stock_agent)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_bash.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/phase_lock.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
